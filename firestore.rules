rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Data Model:
    // Collection: users
    // Document ID: userId (auth.uid)
    // Fields:
    //   - uid: string
    //   - displayName: string
    //   - email: string
    //   - role: 'student' | 'teacher' | 'admin'
    //   - photoURL: optional string
    //   - createdAt: string
    //   - lastLogin: string
    //
    // Collection: attendance
    // Document ID: studentId
    //
    // Collection: scores
    // Document ID: scoreId
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email == "thule020895@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'lastLogin']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 150 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['student', 'teacher', 'admin'] &&
             data.createdAt is string &&
             data.lastLogin is string;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['name', 'count', 'lastPlayed']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.count is number && data.count >= 0 &&
             data.lastPlayed is string;
    }

    function isValidScore(data) {
      return data.keys().hasAll(['name', 'score', 'round', 'date']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.score is number && data.score >= 0 &&
             data.round is number && data.round >= 1 && data.round <= 5 &&
             data.date is string;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /attendance/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidAttendance(request.resource.data);
      allow delete: if isAdmin();
    }

    match /scores/{scoreId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidScore(request.resource.data);
      allow update, delete: if isAdmin();
    }
  }
}
